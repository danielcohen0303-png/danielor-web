{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "brief.danielor.ai"
        }
      ],
      "continue": true,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "brief.danielor.ai"
        }
      ],
      "dest": "/brief/index.html"
    },
    {
      "src": "/([A-Za-z0-9]{8,32})/?",
      "has": [
        {
          "type": "host",
          "value": "brief.danielor.ai"
        }
      ],
      "dest": "/brief/index.html"
    }
  ]
}
